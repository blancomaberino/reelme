# Dependencies
node_modules
vendor/

# Environment
.env
.env.*.local
apps/api/.env

# Laravel
apps/api/storage/*.key
apps/api/public/storage
apps/api/.phpunit.cache

# Filament published assets — republished by `filament:upgrade` (post-autoload-dump)
apps/api/public/css/filament/
apps/api/public/js/filament/
apps/api/public/fonts/filament/

# Expo / React Native prebuild artifacts (managed workflow regenerates these)
.expo/
apps/mobile/ios/
apps/mobile/android/

# Build output
dist/

# Logs
*.log

# OS / editors
.DS_Store
.idea/
.vscode/
!.vscode/extensions.json

# graphify — local knowledge-graph cache/artifacts (rebuilt on demand & post-commit)
graphify-out/

# Claude Code — the shared setup (skills, agents, hooks, settings.json) IS committed;
# these are per-machine: personal overrides, scheduler runtime state, and the
# context-handoff working notes (session state, not source).
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/state/
